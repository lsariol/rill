<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Rill: open-source licenses</title>
<style>
  :root { color-scheme: dark; }
  body { margin: 0; background: #1e1f22; color: #dcddde; font: 15px/1.6 "Segoe UI", system-ui, sans-serif; }
  main { max-width: 880px; margin: 0 auto; padding: 40px 20px 64px; }
  h1 { font-size: 30px; margin: 0 0 8px; }
  h2 { font-size: 22px; margin: 40px 0 12px; }
  h3 { font-size: 18px; margin: 0 0 8px; }
  p, li { color: #b5bac1; }
  a { color: #00a8fc; text-decoration: none; }
  a:hover { text-decoration: underline; }
  .overview { columns: 2; padding-left: 20px; }
  .license { background: #2b2d31; border: 1px solid #3f4147; border-radius: 10px; padding: 18px; margin: 16px 0; }
  .used-by { font-size: 13px; padding-left: 20px; columns: 2; }
  pre { white-space: pre-wrap; background: #1e1f22; border-radius: 6px; padding: 12px; font-size: 12px; color: #b5bac1; }
  @media (max-width: 600px) { .overview, .used-by { columns: 1; } }
</style>
</head>
<body>
<main>
<h1>Open-source licenses</h1>
<p>Rill is free and open source under the MIT license, and is built with the open-source software below. Each license's text follows the list of the software that uses it.</p>
<h2>Licenses</h2>
<ul class="overview">
{{#each overview}}
  <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>
<h2>License texts</h2>
{{#each licenses}}
<section class="license">
  <h3 id="{{id}}">{{name}}</h3>
  <p>Used by:</p>
  <ul class="used-by">
  {{#each used_by}}
    <li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
  {{/each}}
  </ul>
  <pre>{{text}}</pre>
</section>
{{/each}}
</main>
</body>
</html>
